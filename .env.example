# Autonomous VAPT Dashboard - Environment Configuration Template
# Copy this file to .env to configure local server port and optional environment variables.

# Server Port
PORT=3000

# Optional User Passwords (Can also be managed locally in .users_store.json)
# ADMIN_PASSWORD=your_secure_admin_password
# USER_PASSWORD=your_secure_user_password
# SALES_PASSWORD=your_secure_sales_password

# Strix VAPT Automation Webhook Endpoints
# N8N_WEBHOOK_URL=https://your-n8n-host/webhook/trigger-uuid
# N8N_FETCH_WEBHOOK_URL=https://your-n8n-host/webhook/fetch-uuid
