{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Sennovate Elevation & Shadow Tokens",
  "version": "1.0.0",
  "authority": "PRODUCT UI STANDARD",
  "shadows": {
    "none": { "value": "none" },
    "sm": {
      "value": "0 1px 2px 0 rgba(10, 25, 47, 0.05)",
      "description": "Subtle card border support"
    },
    "md": {
      "value": "0 4px 6px -1px rgba(10, 25, 47, 0.08), 0 2px 4px -1px rgba(10, 25, 47, 0.04)",
      "description": "Dropdown menus, popovers, interactive card hover"
    },
    "lg": {
      "value": "0 10px 15px -3px rgba(10, 25, 47, 0.1), 0 4px 6px -2px rgba(10, 25, 47, 0.05)",
      "description": "Modals, slide-over panels, floating action bars"
    },
    "glow": {
      "value": "0 0 15px rgba(0, 240, 255, 0.35)",
      "description": "Accent glow for active security indicators or focus states"
    }
  }
}
